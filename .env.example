# WPGraphQL endpoint
# Local (Flywheel): http://crilio-decants.local/graphql
# Production (Spaceship): https://checkout.example.com/graphql
NEXT_PUBLIC_WORDPRESS_API_URL=http://crilio-decants.local/graphql

# WooCommerce checkout origin (cart handoff target)
# Local: http://crilio-decants.local
# Production: https://checkout.example.com
NEXT_PUBLIC_CHECKOUT_URL=http://crilio-decants.local

# Shared secret for WooCommerce → Next.js cache revalidation webhooks
REVALIDATE_SECRET=replace-with-a-long-random-string
