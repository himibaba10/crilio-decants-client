# WPGraphQL endpoint
# Local (Flywheel): http://crilio-decants.local/graphql
# Production (Spaceship): https://crilio.reactiveferdous.com/graphql
NEXT_PUBLIC_WORDPRESS_API_URL=https://crilio.reactiveferdous.com/graphql

# WooCommerce checkout origin (cart handoff target)
# Local: http://crilio-decants.local
# Production: https://crilio.reactiveferdous.com
NEXT_PUBLIC_CHECKOUT_URL=https://crilio.reactiveferdous.com

# Shared secret for WooCommerce → Next.js cache revalidation webhooks
# Delivery URL example:
# https://crilio-decants-client.vercel.app/api/revalidate?secret=<this-value>
REVALIDATE_SECRET=replace-with-a-long-random-string

# Production storefront: https://crilio-decants-client.vercel.app
